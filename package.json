{
  "name": "dsh-rotation-dashboard",
  "version": "0.3.3",
  "description": "闭环轮转面板：多项目「闭环 → 目标 → 构思 → 执行」泳道视图，含节点会话与项目服务拉起",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./core": "./lib/core.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "web",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-modules"
      ]
    },
    "engines": {
      "dsh": ">=0.2.1-rc.3"
    }
  },
  "scripts": {
    "dev": "node scripts/dev-host.mjs",
    "serve": "node serve.mjs",
    "build:cards": "node scripts/build-cards.mjs",
    "validate:samples": "for f in samples/*.rotation.json; do node validate-rotation.mjs \"$f\" --quiet || exit 1; done",
    "migrate": "node scripts/migrate-samples.mjs",
    "check": "node scripts/check-install.mjs",
    "mock:session": "node scripts/dev-session-mock.mjs",
    "mock:client": "node scripts/dev-client-mock.mjs",
    "lint:plugin": "node scripts/lint-plugin.mjs",
    "preflight": "npm run lint:plugin && npm run mock:client && ROTATION_HOME=\"$(mktemp -d)\" MOCK_WS=\"$(mktemp -d)\" PORT=$((4100 + RANDOM % 800)) node scripts/dev-session-mock.mjs && npm run validate:samples && npm run verify:tarball",
    "verify:tarball": "node scripts/verify-tarball.mjs"
  }
}
