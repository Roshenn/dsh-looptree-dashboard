{
  "name": "dsh-looptree-dashboard",
  "version": "0.17.2",
  "description": "Looptree Dashboard for DSH: one swimlane per project (project vision → milestone → capability loop → execution records) with node sessions, structured prompts and one-click service control",
  "license": "MIT",
  "author": "jrri",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Roshenn/dsh-looptree-dashboard.git"
  },
  "homepage": "https://github.com/Roshenn/dsh-looptree-dashboard#readme",
  "bugs": {
    "url": "https://github.com/Roshenn/dsh-looptree-dashboard/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "dashboard",
    "kanban",
    "milestone",
    "agent-workflow"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./core": "./lib/core.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "web",
    "assets",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-modules"
      ]
    },
    "engines": {
      "dsh": ">=0.2.1-rc.3"
    }
  },
  "scripts": {
    "dev": "node scripts/dev-host.mjs",
    "serve": "node serve.mjs",
    "build:cards": "node scripts/build-cards.mjs",
    "validate:samples": "node scripts/validate-samples.mjs",
    "migrate": "node scripts/migrate-samples.mjs",
    "migrate:single-idea": "node scripts/migrate-single-idea.mjs",
    "migrate:blockers": "node scripts/migrate-blockers.mjs",
    "migrate:milestone": "node scripts/migrate-milestone.mjs",
    "migrate:supports": "node scripts/migrate-supports.mjs",
    "check": "node scripts/check-install.mjs",
    "mock:session": "node scripts/dev-session-mock.mjs",
    "mock:action": "node scripts/action-mock.mjs",
    "mock:closure": "node scripts/closure-mock.mjs",
    "mock:prompt": "node scripts/prompt-mock.mjs",
    "mock:registry": "node scripts/registry-mock.mjs",
    "mock:services": "node scripts/services-collect-mock.mjs",
    "mock:services-batch": "node scripts/services-batch-mock.mjs",
    "mock:stale-run": "node scripts/stale-run-mock.mjs",
    "mock:idle": "node scripts/idle-branch-mock.mjs",
    "mock:genbtn": "node scripts/genbtn-mock.mjs",
    "mock:hide-closed": "node scripts/hide-closed-mock.mjs",
    "mock:list-fields": "node scripts/list-fields-mock.mjs",
    "mock:candtip": "node scripts/candtip-mock.mjs",
    "mock:candidates": "node scripts/candidates-mock.mjs",
    "mock:client": "node scripts/dev-client-mock.mjs",
    "lint:plugin": "node scripts/lint-plugin.mjs",
    "preflight": "node scripts/preflight.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "migrate:capabilities": "node scripts/migrate-capabilities.mjs",
    "mock:refresh": "node scripts/refresh-mock.mjs",
    "mock:stamp": "node scripts/stamp-mock.mjs",
    "mock:crash": "node scripts/crash-recovery-mock.mjs"
  }
}
