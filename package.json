{
  "name": "dsh-looptree-dashboard",
  "version": "0.10.6",
  "description": "轮转闭环树面板：多项目「闭环 → 目标 → 构思 → 执行验证反馈记录」泳道视图，含节点会话、DSH /plan 与 /goal 动作、项目服务拉起",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./core": "./lib/core.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "web",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-modules"
      ]
    },
    "engines": {
      "dsh": ">=0.2.1-rc.3"
    }
  },
  "scripts": {
    "dev": "node scripts/dev-host.mjs",
    "serve": "node serve.mjs",
    "build:cards": "node scripts/build-cards.mjs",
    "validate:samples": "node scripts/validate-samples.mjs",
    "migrate": "node scripts/migrate-samples.mjs",
    "migrate:single-idea": "node scripts/migrate-single-idea.mjs",
    "check": "node scripts/check-install.mjs",
    "mock:session": "node scripts/dev-session-mock.mjs",
    "mock:action": "node scripts/action-mock.mjs",
    "mock:prompt": "node scripts/prompt-mock.mjs",
    "mock:idea-lock": "node scripts/idea-lock-mock.mjs",
    "mock:registry": "node scripts/registry-mock.mjs",
    "mock:services": "node scripts/services-collect-mock.mjs",
    "mock:stale-run": "node scripts/stale-run-mock.mjs",
    "mock:client": "node scripts/dev-client-mock.mjs",
    "lint:plugin": "node scripts/lint-plugin.mjs",
    "preflight": "node scripts/preflight.mjs",
    "verify:package": "node scripts/verify-package.mjs"
  }
}
